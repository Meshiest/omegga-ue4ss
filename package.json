{
  "name": "omegga-ue4ss",
  "version": "0.3.0",
  "private": true,
  "description": "UE4SS for Brickadia Linux servers, as an omegga plugin",
  "license": "CC0-1.0",
  "scripts": {
    "typecheck": "tsc -p .",
    "build:dev": "tsc -p tsconfig.dev.json",
    "verify": "npm run -s build:dev && node build/tools/verify-cli.js",
    "acceptance": "npm run -s build:dev && node build/tools/acceptance.js",
    "dumpq": "npm run -s build:dev && node build/tools/dumpq.js",
    "enums": "npm run -s build:dev && node build/tools/enums.js",
    "test": "npm run -s build:dev && npm run -s typecheck:tools && node --test \"build/test/*.test.js\" && node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tools/*.test.ts\"",
    "typecheck:tools": "tsc -p tsconfig.tools.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Meshiest/omegga-ue4ss.git"
  }
}
