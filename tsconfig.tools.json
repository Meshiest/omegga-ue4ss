{
  "//": "Tools Node runs directly with type stripping (tools/fetch-runtime.ts, tools/runtime-keys.ts and their tests): type-checked here, never built",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["tools/fetch-runtime.ts", "tools/fetch-runtime.test.ts", "tools/runtime-keys.ts"]
}
