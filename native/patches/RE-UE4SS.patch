+#ifdef __linux__
+        // Exact Itanium vtable offsets, for engine forks whose virtuals don't line up with
+        // any MSVC-ordered layout plus the destructor shift. One `Class.Function = 0xOFFSET`
+        // per line; applied after VTableLayout.ini so they win. Values are true offsets;
+        // they are stored 8 lower because adjust_unreal_virtual_function_offset adds the
+        // second Itanium destructor slot back for anything past __vecDelDtor.
+        TRY([&]() {
+            const auto path = m_working_directory / STR("VTableOffsets.linux.ini");
+            if (!std::filesystem::exists(path)) { return; }
+            const std::unordered_map<std::string, std::unordered_map<File::StringType, uint32_t>*> maps{
+                    {"UObject", &Unreal::UObject::VTableLayoutMap},
+                    {"UEngine", &Unreal::UEngine::VTableLayoutMap},
+                    {"UStruct", &Unreal::UStruct::VTableLayoutMap},
+                    {"UField", &Unreal::UField::VTableLayoutMap},
+                    {"FField", &Unreal::FField::VTableLayoutMap},
+                    {"FProperty", &Unreal::FProperty::VTableLayoutMap},
+                    {"AActor", &Unreal::AActor::VTableLayoutMap},
+                    {"FOutputDevice", &Unreal::FOutputDevice::VTableLayoutMap},
+            };
+            std::ifstream in{path};
+            std::string line;
+            while (std::getline(in, line))
+            {
+                if (auto comment = line.find(';'); comment != std::string::npos) { line.erase(comment); }
+                const auto dot = line.find('.');
+                const auto eq = line.find('=');
+                if (dot == std::string::npos || eq == std::string::npos || dot > eq) { continue; }
+                auto trim = [](std::string v) {
+                    v.erase(0, v.find_first_not_of(" \t\r"));
+                    v.erase(v.find_last_not_of(" \t\r") + 1);
+                    return v;
+                };
+                const auto cls = trim(line.substr(0, dot));
+                const auto fn = trim(line.substr(dot + 1, eq - dot - 1));
+                const auto offset = static_cast<uint32_t>(std::stoul(trim(line.substr(eq + 1)), nullptr, 0));
+                const auto map = maps.find(cls);
+                if (map == maps.end() || offset < 0x10)
+                {
+                    Output::send<LogLevel::Warning>(STR("VTableOffsets.linux.ini: ignoring '{}'\n"), ensure_str(line));
+                    continue;
+                }
+                map->second->insert_or_assign(ensure_str(fn), offset - 8);
+                Output::send(STR("{}::{} = 0x{:X} (exact)\n"), ensure_str(cls), ensure_str(fn), offset);
+            }
+        });
+#endif
+
         config.bHookProcessInternal = settings_manager.Hooks.HookProcessInternal;
         config.bHookProcessLocalScriptFunction = settings_manager.Hooks.HookProcessLocalScriptFunction;
         config.bHookLoadMap = settings_manager.Hooks.HookLoadMap;
@@ -950,6 +1001,7 @@ namespace RC
