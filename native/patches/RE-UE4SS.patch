--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -96,6 +96,14 @@ if(WIN32)
     add_subdirectory("cppmods")
 endif()
 
+# Out-of-tree C++ mods built against this tree's UE4SS target, e.g. a game-specific
+# bridge kept in another repository. A list of source directories.
+set(UE4SS_EXTRA_CPPMODS "" CACHE STRING "Extra C++ mod source directories")
+foreach(mod_dir ${UE4SS_EXTRA_CPPMODS})
+    get_filename_component(mod_name "${mod_dir}" NAME)
+    add_subdirectory("${mod_dir}" "${CMAKE_BINARY_DIR}/extra_cppmods/${mod_name}")
+endforeach()
+
 option(UE4SS_BUILD_TESTS "Build native unit tests" OFF)
 if(UE4SS_BUILD_TESTS)
     enable_testing()
