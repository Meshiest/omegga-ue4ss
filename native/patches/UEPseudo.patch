             if (FunctionAddressOverride) { ConstructorInternal.assign_temp_address(FunctionAddressOverride); }
 
 #if PLATFORM_LINUX
-            ConstructorInternal(this, StrName, FindType);
+            if (bConstructorTakesStringView)
+            {
+                // MakeDetectNumber takes an FNameStringView split across two registers:
+                // the chars, then Len | (bIsWide << 32), where bIsWide means some char is
+                // above 0x7F. The 8-byte FName {ComparisonIndex, Number} returns in rax.
+                uint64 Len = 0;
+                uint32 AllBits = 0;
+                for (const CharType* Char = StrName; *Char; ++Char)
+                {
+                    AllBits |= static_cast<uint16>(*Char);
+                    ++Len;
+                }
+                const uint64 LenAndWide = Len | (static_cast<uint64>(AllBits > 0x7F) << 32);
+                // The Function wrapper is typed for the constructor ABI; this ABI has a
+                // different signature, so the raw address is reinterpreted once here.
+                using MakeDetectNumberType = uint64 (*)(const CharType*, uint64, EFindName);
+                const auto MakeDetectNumber = reinterpret_cast<MakeDetectNumberType>(ConstructorInternal.get_function_address());
+                const uint64 Packed = MakeDetectNumber(StrName, LenAndWide, FindType);
+                ComparisonIndex = FNameEntryId::FromUnstableInt(static_cast<uint32>(Packed));
+                Number = static_cast<uint32>(Packed >> 32);
+            }
+            else
+            {
+                ConstructorInternal(this, StrName, FindType);
+            }
 #else
             FName Name = ConstructorInternal(StrName, FindType);
             ComparisonIndex = Name.ComparisonIndex;
